#!/usr/bin/env bash
#MISE description="Attach the NDK's lldb to the running Android app (installed with GLUE5_ANDROID_DEBUGGABLE=1)"
#MISE raw=true
#USAGE arg "[args]..." var=#true help="Passed on to lldb (e.g. -b -o 'br set -n wasm_rt_trap_unreachable' -o continue)"
# As Android Studio does: lldb-server runs in the app's sandbox (run-as),
# lldb connects to it over adb; symbols come from the unstripped libraries.
. "$(dirname "$0")/lib.sh"

sdk_packages
ndk=$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/$(ls "$ANDROID_NDK_HOME/toolchains/llvm/prebuilt")
server=$(ls "$ndk"/lib/clang/*/lib/linux/aarch64/lldb-server | head -1)
pid=$(adb shell pidof -s "$package") || die "the app is not running: mise run android"
adb shell run-as "$package" true 2>/dev/null || die "the app is not debuggable: GLUE5_ANDROID_DEBUGGABLE=1 mise run android"
adb push "$server" /data/local/tmp/lldb-server >/dev/null
# A server left from an earlier session holds the file.
adb shell run-as "$package" pkill lldb-server >/dev/null 2>&1 || true
adb shell run-as "$package" cp /data/local/tmp/lldb-server ./lldb-server
adb shell run-as "$package" chmod 700 ./lldb-server
socket=/$package/lldb.sock
adb shell run-as "$package" ./lldb-server platform --server --listen "unix-abstract://$socket" &
server_pid=$!
trap 'kill $server_pid 2>/dev/null; adb shell run-as "$package" pkill lldb-server >/dev/null 2>&1' EXIT
sleep 1
lib=$PWD/target/$target/release
# The NDK's lldb for macOS cannot load its own Python (its hardened runtime
# ignores DYLD_LIBRARY_PATH); Xcode's has the remote-android platform too.
if [ "$(uname -s)" = Darwin ]; then lldb=(xcrun lldb); else lldb=("$ndk/bin/lldb.sh"); fi
"${lldb[@]}" \
    -o "platform select remote-android" \
    -o "platform connect unix-abstract-connect://$socket" \
    -o "process attach -p $pid" \
    -o "target symbols add $lib/libglue5.so" \
    -o "target symbols add $lib/libSDL3.so" \
    "$@"
